<?xml version="1.0" encoding="utf-8"?>
<!-- GeekOS: SeekBar 进度条 (薰衣草紫) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/geek_radius_full" />
            <gradient
                android:angle="270"
                android:centerColor="@color/geek_bg_elevated"
                android:centerY="0.75"
                android:endColor="@color/geek_bg_elevated"
                android:startColor="@color/geek_bg_elevated" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/geek_radius_full" />
                <solid android:color="@color/geek_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
