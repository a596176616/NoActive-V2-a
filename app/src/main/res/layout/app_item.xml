<?xml version="1.0" encoding="utf-8"?>
<!-- GeekOS: 应用列表项 - 圆角图标 + 主副标题 + 徽章集群 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/geek_list_item_height"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/geek_space_4"
    android:paddingVertical="@dimen/geek_space_3">

    <!-- 圆角图标容器 (accent_soft 背景) -->
    <FrameLayout
        android:layout_width="@dimen/geek_app_icon_size"
        android:layout_height="@dimen/geek_app_icon_size"
        android:background="@drawable/geek_app_icon_bg">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="6dp"
            android:src="@mipmap/ic_logo" />
    </FrameLayout>

    <!-- 中间：应用名 + 包名 + 徽章集群 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/geek_space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 应用名 + 徽章集群 (主行) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/geek_text_primary"
                android:textSize="@dimen/geek_text_body"
                android:textStyle="bold" />

            <!-- 徽章集群 -->
            <TextView
                android:id="@+id/white_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/geek_space_2"
                android:background="@drawable/geek_badge_info"
                android:text="@string/white_app"
                android:textColor="@color/geek_info"
                android:textSize="@dimen/geek_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/app_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/geek_space_2"
                android:background="@drawable/geek_badge_warning"
                android:text="@string/direct_app"
                android:textColor="@color/geek_warning"
                android:textSize="@dimen/geek_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/black_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/geek_space_2"
                android:background="@drawable/geek_badge_danger"
                android:text="@string/black_app"
                android:textColor="@color/geek_danger"
                android:textSize="@dimen/geek_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/other_config"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/geek_space_2"
                android:background="@drawable/geek_badge_success"
                android:text="@string/other_config"
                android:textColor="@color/geek_success"
                android:textSize="@dimen/geek_text_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/battery_opt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/geek_space_2"
                android:background="@drawable/geek_badge_accent"
                android:text="@string/battery_opt"
                android:textColor="@color/geek_accent"
                android:textSize="@dimen/geek_text_label"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 包名 (副行) -->
        <TextView
            android:id="@+id/package_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/geek_text_tertiary"
            android:textSize="@dimen/geek_text_caption" />

    </LinearLayout>

</LinearLayout>
