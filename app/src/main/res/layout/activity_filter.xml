<?xml version="1.0" encoding="utf-8"?>
<!-- GeekOS: 过滤条 - 药丸形搜索栏 + 分段 Spinner -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/geek_space_4"
    android:paddingTop="@dimen/geek_space_2"
    android:paddingBottom="@dimen/geek_space_3">

    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/geek_search_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/geek_search_bar_bg"
        android:paddingHorizontal="@dimen/geek_space_4"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/geek_space_3"
            android:src="@drawable/ic_search_geek"
            android:contentDescription="@string/search"
            app:tint="@color/geek_text_tertiary" />

        <EditText
            android:id="@+id/search_txt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints=""
            android:background="@android:color/transparent"
            android:ems="10"
            android:hint="@string/search"
            android:inputType="textFilter"
            android:textColor="@color/geek_text_primary"
            android:textColorHint="@color/geek_text_tertiary"
            android:textSize="@dimen/geek_text_body" />
    </LinearLayout>

    <Spinner
        android:id="@+id/app_scope"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/geek_space_3"
        android:background="@android:color/transparent"
        android:entries="@array/app_filter"
        android:popupBackground="@drawable/shape_for_custom_spinner"
        android:textAlignment="textStart"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_container" />

    <!-- 装饰性底部紫线 (品牌色细条) -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/geek_space_2"
        android:background="@color/geek_accent_soft"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
