<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================================
         GeekOS Design System — Theme (Deep-first, lavender accent)
         Force dark background regardless of system setting,
         to preserve the GeekOS "deep-first" aesthetic.
         ============================================================ -->
    <style name="Theme.NoActive" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand: 深色 surface -->
        <item name="colorPrimary">@color/geek_bg_surface</item>
        <item name="colorPrimaryVariant">@color/geek_bg_surface_variant</item>
        <item name="colorOnPrimary">@color/geek_text_primary</item>
        <!-- Secondary brand: 薰衣草紫 accent -->
        <item name="colorSecondary">@color/geek_accent</item>
        <item name="colorSecondaryVariant">@color/geek_accent_strong</item>
        <item name="colorOnSecondary">@color/geek_text_on_primary</item>
        <!-- Background & window -->
        <item name="android:windowBackground">@color/geek_bg_base</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/geek_bg_base</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/geek_bg_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/geek_text_primary</item>
        <item name="android:textColorSecondary">@color/geek_text_secondary</item>
        <item name="android:textColorTertiary">@color/geek_text_tertiary</item>
        <!-- Edge-to-edge draw behind system bars -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
        <!-- Force dark, do not allow system to invert -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Material component overrides -->
        <item name="colorSurface">@color/geek_bg_surface</item>
        <item name="colorOnSurface">@color/geek_text_primary</item>
        <item name="colorError">@color/geek_danger</item>
        <item name="colorOnError">@color/geek_text_primary</item>
    </style>

    <style name="Theme.NoActive.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.NoActive.MenuColor">
        <item name="colorControlNormal">@color/geek_text_primary</item>
    </style>

    <style name="Theme.NoActive.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:colorPrimary">@color/geek_bg_base</item>
        <item name="android:colorBackground">@color/geek_bg_base</item>
    </style>

    <style name="Theme.NoActive.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="android:colorBackground">@color/geek_bg_elevated</item>
        <item name="android:textColorPrimary">@color/geek_text_primary</item>
        <item name="android:textColorSecondary">@color/geek_text_secondary</item>
    </style>

    <!-- Toolbar 标题样式 -->
    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- GeekOS 文本样式 -->
    <style name="TextAppearance.GeekOS.Display" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_display</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GeekOS.H1" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_h1</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GeekOS.H2" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_h2</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.GeekOS.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_body</item>
        <item name="android:textColor">@color/geek_text_primary</item>
    </style>

    <style name="TextAppearance.GeekOS.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_caption</item>
        <item name="android:textColor">@color/geek_text_secondary</item>
    </style>

    <style name="TextAppearance.GeekOS.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_label</item>
        <item name="android:textColor">@color/geek_text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.GeekOS.Mono" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/geek_text_mono</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- GeekOS 控件样式 -->
    <style name="Widget.GeekOS.SearchBar" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/geek_search_bar_bg</item>
        <item name="android:textColor">@color/geek_text_primary</item>
        <item name="android:textColorHint">@color/geek_text_tertiary</item>
        <item name="android:textSize">@dimen/geek_text_body</item>
        <item name="android:paddingStart">@dimen/geek_space_4</item>
        <item name="android:paddingEnd">@dimen/geek_space_4</item>
        <item name="android:paddingTop">@dimen/geek_space_3</item>
        <item name="android:paddingBottom">@dimen/geek_space_3</item>
    </style>

    <style name="Widget.GeekOS.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/geek_bg_surface</item>
        <item name="cardCornerRadius">@dimen/geek_radius_xl</item>
        <item name="cardElevation">@dimen/geek_elevation_1</item>
        <item name="contentPadding">@dimen/geek_space_4</item>
        <item name="strokeColor">@color/geek_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.GeekOS.PillButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/geek_text_on_primary</item>
        <item name="backgroundTint">@color/geek_accent</item>
        <item name="cornerRadius">@dimen/geek_radius_full</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textSize">@dimen/geek_text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">@dimen/geek_space_5</item>
        <item name="android:paddingEnd">@dimen/geek_space_5</item>
    </style>

    <style name="Widget.GeekOS.PillButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/geek_accent</item>
        <item name="strokeColor">@color/geek_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/geek_radius_full</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textSize">@dimen/geek_text_body</item>
        <item name="android:paddingStart">@dimen/geek_space_5</item>
        <item name="android:paddingEnd">@dimen/geek_space_5</item>
    </style>
</resources>
